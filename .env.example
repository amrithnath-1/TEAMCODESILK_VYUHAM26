# Enables Claude for document analysis, plan drafting, resume extraction and the chat assistant.
# Without it those features run in clearly labelled rule-based mode.
ANTHROPIC_API_KEY=
AF07_MODEL=claude-opus-5-5
# Token-signing secret. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Required outside development. Changing it signs everyone out.
AF07_SECRET_KEY=
AF07_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# development, staging or production. Outside development, demo data is never seeded and reset is refused.
VYUHAM_ENV=development
