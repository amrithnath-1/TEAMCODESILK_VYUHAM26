# Enables Claude for document analysis, plan drafting, resume extraction and the chat assistant.
# Without it those features run in clearly labelled rule-based mode.
ANTHROPIC_API_KEY=
AF07_MODEL=claude-opus-5-5
# Token-signing secret. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Required outside development. Changing it signs everyone out.
AF07_SECRET_KEY=
AF07_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# development, staging or production. Outside development, demo data is never seeded and reset is refused.
VYUHAM_ENV=development
# Optional: most Claude calls one company may make per day. Set this on any public deployment.
AF07_DAILY_AI_CALLS=
# Optional: use Supabase Postgres instead of local SQLite (session pooler URL, port 5432).
# Symbols in the password must be percent-encoded. VYUHAM_ENV is required when this is set.
SUPABASE_DB_URL=
# Owner login used only for schema migrations. SUPABASE_DB_URL should be the restricted vyuham_app role, so row-level security applies.
SUPABASE_MIGRATION_DB_URL=
# The Supabase project where reset and demo seeding are allowed. Never set this to production.
VYUHAM_DEV_PROJECT_REF=
