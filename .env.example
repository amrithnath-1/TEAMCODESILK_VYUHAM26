# Enables Claude for document analysis, plan drafting, resume extraction and the chat assistant.
# Without it those features run in clearly labelled rule-based mode.
ANTHROPIC_API_KEY=
AF07_MODEL=claude-opus-5-5
# Optional: fixed token-signing secret so sessions survive API restarts.
AF07_SECRET_KEY=
AF07_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
